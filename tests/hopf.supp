# Valgrind suppressions for known third-party leaks / errors that aren't
# triggered by Hopf's own code. Re-run with:
#   valgrind --suppressions=tests/hopf.supp ...

# miniaudio 0.11.21 leaks 744 bytes from ma_sound_init_from_file_internal
# when the clip path doesn't exist. Our test_audio "unloadable clip" case
# exercises that error path on purpose. The mangled frame names below match
# what valgrind shows (the helpers are static so the demangler reports them
# as _ZL...).
{
   miniaudio-leak-on-missing-clip
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   fun:*ma__malloc_default*
   fun:ma_malloc
   fun:*ma_sound_init_from_file_internal*
   ...
}

# miniaudio 0.11.21 read-after-free inside
# ma_resource_manager_data_buffer_node_acquire on the same error path.
# Already freed the node, then reads a flag from it.
{
   miniaudio-uaf-resource-manager-node
   Memcheck:Addr4
   fun:*ma_resource_manager_data_buffer_node_acquire*
   ...
}
